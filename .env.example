# AI Dispute Assistant (optional).
# Without this key the assistant still works — it generates the summary
# directly from your Taskora records instead of having Claude write it.
# Server-side only: never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Proof capture (optional).
# With this key, attaching a screenshot to a deliverable offers to read it and
# fill in the title, notes, amount and any client approval it shows. Without
# it the button never appears and the form works exactly as before.
# Server-side only: never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Vision model used for proof capture. Defaults to gpt-4o.
# Any model with vision + strict structured outputs works here.
OPENAI_MODEL=

# Google sign-in via Firebase (optional).
# Firebase brokers the Google popup and the resulting ID token is exchanged for
# a normal Supabase session, so Supabase stays the only source of truth.
# Copy these from Firebase console -> Project settings -> Your apps -> Web app.
# Leave any of them blank and the "Sign in with Google" button never renders.
# These are public by design — Firebase web config is not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
